# API de Lumon (Swagger: https://lumon-api.vercel.app/docs)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Storage de imágenes: SUPABASE o CLOUDINARY
VITE_STORAGE_PROVIDER=

# Supabase Storage (solo la clave PUBLICABLE: sb_publishable_... o el JWT anon; nunca la secreta ni service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=lumon-media

# Cloudinary (solo cloud name y preset UNSIGNED; nunca el API secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Solo en el hosting (no lleva prefijo VITE_, no entra al bundle): token de /integrations/deploy/challenge
LUMON_VERIFICATION_TOKEN=
